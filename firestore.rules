rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidShape() {
        return request.resource.data.keys().hasAll([
          "gameVersion",
          "saveVersion",
          "revision",
          "updatedAt",
          "clientSavedAt",
          "deviceId",
          "playerName",
          "playTime",
          "lifetimeDust",
          "totalCores",
          "transcensions",
          "snapshot"
        ])
        && request.resource.data.keys().hasOnly([
          "gameVersion",
          "saveVersion",
          "revision",
          "updatedAt",
          "clientSavedAt",
          "deviceId",
          "playerName",
          "playTime",
          "lifetimeDust",
          "totalCores",
          "transcensions",
          "snapshot"
        ])
        && request.resource.data.gameVersion is string
        && request.resource.data.gameVersion.size() <= 20
        && request.resource.data.saveVersion is int
        && request.resource.data.saveVersion >= 1
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.clientSavedAt is number
        && request.resource.data.clientSavedAt >= 0
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 80
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() <= 24
        && request.resource.data.playTime is number
        && request.resource.data.playTime >= 0
        && request.resource.data.lifetimeDust is number
        && request.resource.data.lifetimeDust >= 0
        && request.resource.data.totalCores is number
        && request.resource.data.totalCores >= 0
        && request.resource.data.transcensions is int
        && request.resource.data.transcensions >= 0
        && request.resource.data.snapshot is map;
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && hasValidShape();
    }

    match /leaderboards/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidLeaderboardShape() {
        return request.resource.data.keys().hasAll([
          "gameVersion",
          "playerName",
          "careerDust",
          "highestPower",
          "battleCount",
          "transcensions",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "gameVersion",
          "playerName",
          "careerDust",
          "highestPower",
          "battleCount",
          "transcensions",
          "updatedAt"
        ])
        && request.resource.data.gameVersion is string
        && request.resource.data.gameVersion.size() <= 20
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 1
        && request.resource.data.playerName.size() <= 24
        && request.resource.data.careerDust is number
        && request.resource.data.careerDust >= 0
        && request.resource.data.highestPower is number
        && request.resource.data.highestPower >= 0
        && request.resource.data.battleCount is int
        && request.resource.data.battleCount >= 0
        && request.resource.data.battleCount <= 9007199254740991
        && request.resource.data.transcensions is int
        && request.resource.data.transcensions >= 0
        && request.resource.data.transcensions <= 9007199254740991
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      }

      function doesNotLowerCareerRecords() {
        return request.resource.data.careerDust >= resource.data.careerDust
          && request.resource.data.highestPower >= resource.data.highestPower
          && request.resource.data.battleCount >= resource.data.battleCount
          && request.resource.data.transcensions >= resource.data.transcensions;
      }

      allow read: if request.auth != null;
      allow create: if isOwner() && hasValidLeaderboardShape();
      allow update: if isOwner()
        && hasValidLeaderboardShape()
        && doesNotLowerCareerRecords();
      allow delete: if isOwner();
    }
  }
}
