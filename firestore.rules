rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // 存档正文仅允许本人读写。这里只校验跨版本都稳定存在的信封字段，
      // 避免游戏新增元数据后，旧的固定字段白名单把合法新版本存档全部拒绝。
      function hasValidEnvelope() {
        return request.resource.data.keys().hasAll([
          "revision",
          "snapshot"
        ])
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && (
          request.resource.data.snapshot is map
          || (
            request.resource.data.snapshot is string
            && request.resource.data.snapshot.size() <= 700000
          )
        );
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && hasValidEnvelope();
    }

    match /leaderboards/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidLeaderboardShape() {
        return request.resource.data.keys().hasAll([
          "gameVersion",
          "playerName",
          "highestRate",
          "highestPower",
          "highestResearch",
          "highestStarport",
          "battleCount",
          "expeditionRuns",
          "expeditionBossWins",
          "transcensions",
          "frontierSectors",
          "groupId",
          "seasonId",
          "seasonScore",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "gameVersion",
          "playerName",
          "highestRate",
          "highestPower",
          "highestResearch",
          "highestStarport",
          "battleCount",
          "expeditionRuns",
          "expeditionBossWins",
          "transcensions",
          "frontierSectors",
          "groupId",
          "seasonId",
          "seasonScore",
          "updatedAt"
        ])
        && request.resource.data.gameVersion is string
        && request.resource.data.gameVersion.size() <= 20
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 1
        && request.resource.data.playerName.size() <= 24
        && request.resource.data.highestRate is number
        && request.resource.data.highestRate >= 0
        && request.resource.data.highestRate <= 9999000000
        && request.resource.data.highestPower is number
        && request.resource.data.highestPower >= 0
        && request.resource.data.highestResearch is int
        && request.resource.data.highestResearch >= 0
        && request.resource.data.highestResearch <= 24
        && request.resource.data.highestStarport is int
        && request.resource.data.highestStarport >= 0
        && request.resource.data.highestStarport <= 72
        && request.resource.data.battleCount is int
        && request.resource.data.battleCount >= 0
        && request.resource.data.battleCount <= 9007199254740991
        && request.resource.data.transcensions is int
        && request.resource.data.transcensions >= 0
        && request.resource.data.transcensions <= 9007199254740991
        && request.resource.data.expeditionRuns is int
        && request.resource.data.expeditionRuns >= 0
        && request.resource.data.expeditionRuns <= 9007199254740991
        && request.resource.data.expeditionBossWins is int
        && request.resource.data.expeditionBossWins >= 0
        && request.resource.data.expeditionBossWins <= 9007199254740991
        && request.resource.data.frontierSectors is int
        && request.resource.data.frontierSectors >= 0
        && request.resource.data.frontierSectors <= 9007199254740991
        && (!request.resource.data.keys().hasAll(["groupId"])
          || request.resource.data.groupId in ["beginner", "advanced", "transcend"])
        && (!request.resource.data.keys().hasAll(["seasonId"])
          || (request.resource.data.seasonId is string
            && request.resource.data.seasonId.size() <= 80))
        && (!request.resource.data.keys().hasAll(["seasonScore"])
          || (request.resource.data.seasonScore is int
            && request.resource.data.seasonScore >= 0
            && request.resource.data.seasonScore <= 1000000000))
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      }

      function doesNotLowerCareerRecords() {
        return (!resource.data.keys().hasAll(["highestRate"])
            || request.resource.data.highestRate >= resource.data.highestRate)
          && (!resource.data.keys().hasAll(["highestPower"])
            || request.resource.data.highestPower >= resource.data.highestPower)
          && (!resource.data.keys().hasAll(["highestResearch"])
            || request.resource.data.highestResearch >= resource.data.highestResearch)
          && (!resource.data.keys().hasAll(["highestStarport"])
            || request.resource.data.highestStarport >= resource.data.highestStarport)
          && (!resource.data.keys().hasAll(["battleCount"])
            || request.resource.data.battleCount >= resource.data.battleCount)
          && (!resource.data.keys().hasAll(["expeditionRuns"])
            || request.resource.data.expeditionRuns >= resource.data.expeditionRuns)
          && (!resource.data.keys().hasAll(["expeditionBossWins"])
            || request.resource.data.expeditionBossWins >= resource.data.expeditionBossWins)
          && (!resource.data.keys().hasAll(["transcensions"])
            || request.resource.data.transcensions >= resource.data.transcensions)
          && (!resource.data.keys().hasAll(["frontierSectors"])
            || request.resource.data.frontierSectors >= resource.data.frontierSectors)
          && (!resource.data.keys().hasAll(["seasonId", "seasonScore"])
            || request.resource.data.seasonId != resource.data.seasonId
            || request.resource.data.seasonScore >= resource.data.seasonScore);
      }

      allow read: if request.auth != null;
      allow create: if isOwner() && hasValidLeaderboardShape();
      allow update: if isOwner()
        && hasValidLeaderboardShape()
        && doesNotLowerCareerRecords();
      allow delete: if isOwner();
    }

    // 玩家只能创建反馈，不能读取、修改或删除任何反馈记录。
    // Firebase 控制台与 Admin SDK 不受客户端规则限制，开发者可在那里统一查看和处理。
    match /feedback/{feedbackId} {
      function hasValidFeedbackShape() {
        return request.resource.data.keys().hasAll([
          "userId",
          "userEmail",
          "playerName",
          "gameVersion",
          "category",
          "message",
          "contact",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "userId",
          "userEmail",
          "playerName",
          "gameVersion",
          "category",
          "message",
          "contact",
          "status",
          "createdAt"
        ])
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 254
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() >= 1
        && request.resource.data.playerName.size() <= 24
        && request.resource.data.gameVersion is string
        && request.resource.data.gameVersion.size() <= 20
        && request.resource.data.category in [
          "bug",
          "balance",
          "experience",
          "suggestion",
          "other"
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 120
        && request.resource.data.status == "new"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
      }

      allow create: if request.auth != null && hasValidFeedbackShape();
    }

    // 公告由开发者在 Firebase 控制台发布。客户端只可读取 published=true 的记录。
    match /announcements/{announcementId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // 赛季内容由开发者在控制台替换；本地默认赛季在此集合不可用时仍可运行。
    match /seasonConfigs/{configId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // 每名玩家每期只有一个单调递增的贡献文档，服务端按增量聚合可避免重复累计。
    match /seasonContributions/{seasonId}/players/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidContribution() {
        return request.resource.data.keys().hasAll(["userId", "seasonId", "score", "updatedAt"])
          && request.resource.data.keys().hasOnly(["userId", "seasonId", "score", "updatedAt"])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.seasonId == seasonId
          && request.resource.data.seasonId is string
          && request.resource.data.seasonId.size() <= 80
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 1000000000
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isOwner();
      allow create: if isOwner() && hasValidContribution();
      allow update: if isOwner() && hasValidContribution()
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    // 只能由 Admin SDK / Cloud Function 写入，客户端只读取已发布的可信聚合。
    match /communityTotals/{totalId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // 一键反馈无需填写文本；未登录玩家仍会在本地保存回答。
    match /quickFeedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(["userId", "promptId", "value", "gameVersion", "createdAt"])
        && request.resource.data.keys().hasOnly(["userId", "promptId", "value", "gameVersion", "createdAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.promptId in ["first_jump", "first_expedition", "active_day_7", "repeated_failure"]
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= 5
        && request.resource.data.gameVersion is string
        && request.resource.data.gameVersion.size() <= 20
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
