<?xml version="1.0" encoding="utf-8"?>
<job>
  <script language="JScript" src="../source/game-math.js" />
  <script language="JScript">
    var failures = 0;
    var checks = 0;

    function assertEqual(actual, expected, name) {
      checks += 1;
      if (actual !== expected) {
        failures += 1;
        WScript.Echo("FAIL " + name + ": expected " + expected + ", got " + actual);
      }
    }

    function assertTrue(condition, name) {
      checks += 1;
      if (!condition) {
        failures += 1;
        WScript.Echo("FAIL " + name);
      }
    }

    function assertNear(actual, expected, tolerance, name) {
      assertTrue(
        Math.abs(actual - expected) &lt;= tolerance,
        name + ": expected approximately " + expected + ", got " + actual
      );
    }

    assertEqual(StellarMath.formatNumber(320), "320", "integer trailing zero");
    assertEqual(StellarMath.formatNumber(1e30), "1e30", "scientific notation");
    assertEqual(
      StellarMath.formatNumber(StellarMath.MAX_GAME_NUMBER),
      "1e300",
      "maximum value notation"
    );
    assertEqual(
      StellarMath.safeAdd(StellarMath.MAX_GAME_NUMBER, 1),
      StellarMath.MAX_GAME_NUMBER,
      "addition cap"
    );
    assertEqual(
      StellarMath.safeMultiply(1e200, 1e200),
      StellarMath.MAX_GAME_NUMBER,
      "multiplication cap"
    );
    assertEqual(
      StellarMath.safePow(1.15, 10000),
      StellarMath.MAX_GAME_NUMBER,
      "power cap"
    );
    assertEqual(
      StellarMath.safePow(60, 500),
      StellarMath.MAX_GAME_NUMBER,
      "endgame objective scaling cap"
    );
    assertEqual(
      StellarMath.geometricSeriesCost(15, 1.15, 0, 1, 1),
      15,
      "first building cost"
    );
    assertEqual(
      StellarMath.maxAffordableGeometric(15, 1.15, 100, 0, 1),
      4,
      "maximum affordable amount"
    );

    var lateCost = StellarMath.geometricSeriesCost(15, 1.15, 10000, 10, 1);
    assertEqual(lateCost, StellarMath.MAX_GAME_NUMBER, "late-game cost cap");

    var lateAmount = StellarMath.maxAffordableGeometric(
      15,
      1.15,
      StellarMath.MAX_GAME_NUMBER,
      0,
      1
    );
    assertTrue(lateAmount &gt; 0, "late-game bulk purchase remains finite");
    assertTrue(
      lateAmount &lt; StellarMath.MAX_GAME_COUNT,
      "late-game bulk purchase remains bounded"
    );
    assertEqual(
      Math.ceil(StellarMath.safeMultiply(3, StellarMath.safePow(1.7, 3))),
      15,
      "starport module material growth"
    );
    assertEqual(
      Math.round((1 / (1 + 12 * 0.03)) * 10000) / 10000,
      0.7353,
      "starport logistics cost floor"
    );
    assertNear(
      Math.max(0.82, 1 - 12 * 0.015),
      0.82,
      1e-12,
      "starport radar cooldown floor"
    );
    assertEqual(
      StellarMath.softCapGameNumber(5000, 10000, 0.45),
      5000,
      "soft cap preserves early values"
    );
    assertEqual(
      StellarMath.softCapGameNumber(1e8, 1e6, 0.5),
      1e7,
      "soft cap compresses late values"
    );
    var compressed = StellarMath.softCapGameNumber(1e12, 1e6, 0.55);
    var expanded = StellarMath.expandSoftCappedGameNumber(
      compressed,
      1e6,
      0.55
    );
    assertTrue(
      Math.abs(expanded / 1e12 - 1) &lt; 1e-10,
      "soft cap inverse restores target value"
    );
    assertTrue(compressed &lt; 1e12, "soft cap remains below raw late value");

    if (failures &gt; 0) {
      WScript.Echo(failures + " of " + checks + " numeric checks failed.");
      WScript.Quit(1);
    }
    WScript.Echo("PASS " + checks + " numeric boundary checks.");
  </script>
</job>
